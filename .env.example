# Server
PORT=8096
RUST_LOG=info

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27030
MONGODB_DB=bcaichat

# MinIO Object Storage
MINIO_ENDPOINT=http://127.0.0.1:9130
MINIO_ACCESS_KEY=bcaichatadmin
MINIO_SECRET_KEY=bcaichat_minio_local_dev
MINIO_BUCKET=bcaichat-storage

# Auth & Google OAuth2
JWT_SECRET=replace_with_your_64_char_secret_key_in_local_env
GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPER_ADMIN_EMAIL=jead@bcaichat.local

# DeepSeek AI Assistant
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Push Alerts (Firebase Cloud Messaging) - leave empty to keep push off
FCM_SERVICE_ACCOUNT_FILE=

# ElevenLabs TTS (read locally at runtime for video generation; never commit real keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
